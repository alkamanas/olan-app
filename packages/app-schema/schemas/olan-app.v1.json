    "remote": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "description": "Base URL of the app server: https (http only for loopback/private hosts, in development). Olan posts to {url}/events, {url}/ai-tools/{name} and {url}/card-actions."
        },
        "jwksUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "The app server's public keys (JWKS) for token requests (private_key_jwt)."
        },
        "requests": {
          "description": "Turns on olan.remote.request: Olan posts signed requests to {url}/requests on behalf of the person (default false).",
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "jwksUrl"
      ],
      "additionalProperties": false,
      "description": "The app's own server; implies the \"remote\" permission."
    },
    "events": {
      "description": "Events delivered to {remote.url}/events (needs \"remote\"): chat.message.created, project.task.created, project.task.updated, project.task.deleted, project.task.completed, project.issue.opened, project.issue.closed, project.issue.triaged, project.approval.decided, calendar.event.created, calendar.event.updated, calendar.event.deleted, meeting.created, meeting.started, meeting.ended, meeting.cancelled.",
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "tools": {
          "description": "Assistant tools (≤ 16) run by the app server; implies \"ai:tools\".",
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$",
                "description": "Tool name: ^[a-z][a-z0-9_]{1,31}$, unique in the app."
              },
              "title": {
                "description": "Shown on confirmation cards (≤ 80).",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "What the tool does; goes to the model (1–1024)."
              },
              "input": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                },
                "description": "JSON Schema 2020-12 of the input: \"type\": \"object\" at the root, ≤ 8 KiB, only local $ref."
              },
              "permissions": {
                "default": [],
                "description": "Subset of the manifest permissions; the call token carries only these.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "readOnly": {
                "default": false,
                "description": "Only reads: runs without confirmation and may be retried once.",
                "type": "boolean"
              },
              "destructive": {
                "default": false,
                "description": "Deletes or overwrites: always confirmed. Not together with readOnly.",
                "type": "boolean"
              },
              "timeoutMs": {
                "description": "Call timeout in ms, 1000–60000 (readOnly tools ≤ 15000); default 15000.",
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              }
            },
            "required": [
              "name",
              "description",
              "input"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Olan assistant integration."
    },
    "server": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Backend module inside the package, normally \"server/index.ts\"."
        },
        "schedules": {
          "description": "Scheduled runs (≤ 10, at least 5 minutes apart).",
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "cron": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "function": {
                "description": "Optional fallback: functions[function] of the backend module, used when defineBackend has no schedules[name]. A function named here is never callable from the UI (olan.backend.call).",
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$"
              }
            },
            "required": [
              "name",
              "cron"
            ],
            "additionalProperties": false
          }
        },
        "events": {
          "description": "Event type → fallback function (used when defineBackend has no events[type]; never callable from the UI). Event types: app.installed, app.updated, app.uninstalled, app.consent.changed, chat.message.created, project.task.created, project.task.updated, project.task.deleted, project.task.completed, project.issue.opened, project.issue.closed, project.issue.triaged, project.approval.decided, calendar.event.created, calendar.event.updated, calendar.event.deleted, meeting.created, meeting.started, meeting.ended, meeting.cancelled.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$",
            "description": "Exported function of the backend module."
          }
        },
        "hooks": {
          "description": "Incoming webhooks: POST /api/v2/apps/hooks/<installationId>/<name>.",
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "function": {
                "description": "Optional fallback: functions[function] of the backend module, used when defineBackend has no hooks[name]. A function named here is never callable from the UI (olan.backend.call).",
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$"
              },
              "verify": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "hmac-sha256",
                      "standard-webhooks",
                      "none"
                    ]
                  },
                  "header": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "secretSetting": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "verify"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "entry"
      ],
      "additionalProperties": false,
      "description": "Backend code that runs on the Olan server, in an isolated sandbox (docs/backend.md)."
    },
    "projectTemplates": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
