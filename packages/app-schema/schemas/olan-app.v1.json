                "description": "Organization collections only. Default { read: \"any\", update: \"any\", delete: \"owner\" }.",
                "type": "object",
                "properties": {
                  "read": {
                    "type": "string",
                    "enum": [
                      "any",
                      "owner"
                    ]
                  },
                  "update": {
                    "type": "string",
                    "enum": [
                      "any",
                      "owner"
                    ]
