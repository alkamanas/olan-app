                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "color": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
