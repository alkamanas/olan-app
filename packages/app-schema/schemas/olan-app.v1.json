                    }
                  },
                  "required": [
                    "key",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "statuses": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
