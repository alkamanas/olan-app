{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olan.app/schemas/olan-app/v1.json",
  "title": "Olan app manifest (olan-app.json), schema version 1",
  "description": "Manifest of an Olan app package. Cross-field rules (entry/url per kind, web-link restrictions, duplicate permissions, data limits such as at most 5 indexed fields, remote URLs, event and tool permissions) are checked by `olan-app validate`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL, normally \"https://olan.app/schemas/olan-app/v1.json\".",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Manifest schema version. Currently always 1."
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse-domain app id, e.g. \"com.example.overdue-tasks\" (≤ 128)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Display name (≤ 80)."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "App version (semver)."
    },
    "sdk": {
      "type": "string",
      "description": "Supported @olan-app/sdk range: \"*\", \"x.y.z\", \"^x.y.z\", \"~x.y.z\" or \">=x.y.z <a.b.c\"."
    },
    "minServerVersion": {
      "description": "Oldest Olan server version that can install the app.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "description": {
      "description": "Short description (≤ 400).",
      "type": "string",
      "maxLength": 400
    },
    "entry": {
      "description": "Bundle path inside the package, normally \"dist/app.js\". Required for kind \"app\", absent for \"web-link\".",
      "type": "string"
    },
    "icon": {
      "description": "Icon: a package path (png/svg/jpg/webp) for kind \"app\"; an http(s) URL or Olan icon name for \"web-link\".",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "default": "app",
      "description": "\"app\" (default) or \"web-link\".",
      "type": "string",
      "enum": [
        "app",
        "web-link"
      ]
    },
    "url": {
      "description": "Only for kind \"web-link\": the http(s) address to open.",
      "type": "string"
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "app": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Title shown by the host (≤ 80).",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "description": "Surface options."
        },
        "project.widget": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Title shown by the host (≤ 80).",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "description": "Surface options."
        },
        "settings": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Title shown by the host (≤ 80).",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "description": "Surface options."
        },
        "chat.action": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "chat.command": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the suggestions (1–80, required)."
            },
            "command": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "description": "Command typed after \"/\": ^[a-z][a-z0-9-]{1,31}$."
            },
            "description": {
              "description": "Shown next to the command (≤ 120).",
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "title",
            "command"
          ],
          "additionalProperties": false,
          "description": "chat.command options."
        },
        "chat.card": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "mail.sidebar": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "mail.action": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "calendar.event.action": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "meeting.panel": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "project.tab": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Title shown by the host (≤ 80).",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "description": "Surface options."
        },
        "project.settings": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Title shown by the host (≤ 80).",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "description": "Surface options."
        },
        "task.action": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "issue.action": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        },
        "record.card": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Title shown in the host menu or panel (1–80, required)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Surface options."
        }
      },
      "additionalProperties": false,
      "description": "Surfaces the app provides. Known surfaces: app, project.widget, settings, chat.action, chat.command, chat.card, mail.sidebar, mail.action, calendar.event.action, meeting.panel, project.tab, project.settings, task.action, issue.action, record.card."
    },
    "permissions": {
      "description": "Requested permissions: projects:read, projects:write, tasks:write, tasks:delete, projects:delete, projects:create, projects:archive, projects:extend, users:read, profile:read, chat:read, chat:write, calendar:read, calendar:write, calendar:delete, contacts:read, contacts:write, contacts:delete, mail:read, meetings:read, storage, db, files:pick, settings:read, remote, ai:tools, http:<host>.",
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:projects:read|projects:write|tasks:write|tasks:delete|projects:delete|projects:create|projects:archive|projects:extend|users:read|profile:read|chat:read|chat:write|calendar:read|calendar:write|calendar:delete|contacts:read|contacts:write|contacts:delete|mail:read|meetings:read|storage|db|files:pick|settings:read|remote|ai:tools|http:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?::[0-9]{1,5})?)$"
      }
    },
    "settings": {
      "description": "Settings form fields keyed by setting name.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              },
              "required": {
                "type": "boolean"
              },
              "secret": {
                "description": "Encrypted on the server and masked in admin screens.",
                "type": "boolean"
              },
              "default": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              },
              "required": {
                "type": "boolean"
              },
              "secret": {
                "description": "Encrypted on the server and masked in admin screens.",
                "type": "boolean"
              },
              "default": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              },
              "required": {
                "type": "boolean"
              },
              "secret": {
                "description": "Encrypted on the server and masked in admin screens.",
                "type": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "select"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              },
              "required": {
                "type": "boolean"
              },
              "secret": {
                "description": "Encrypted on the server and masked in admin screens.",
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "label",
              "options"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Data schema version; increase it whenever the schema changes."
        },
        "collections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "organization",
                  "user"
                ],
                "description": "\"organization\" (shared, with rules) or \"user\" (each person sees only their rows)."
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "string"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "maxLength": {
                          "description": "Default 1000, ≤ 10000.",
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "enum": {
                          "minItems": 1,
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "number"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "integer": {
                          "type": "boolean"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "boolean"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "date"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "datetime"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "json"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "ref:project"
                        },
                        "required": {
                          "description": "Value must be present and non-null (default false).",
                          "type": "boolean"
                        },
                        "indexed": {
                          "description": "Usable in where/orderBy (≤ 5 per collection, not json).",
                          "type": "boolean"
                        },
                        "label": {
                          "description": "Label for Studio and exports (≤ 80).",
                          "type": "string",
