{
  "name": "@olan-app/runtime",
  "version": "1.0.1",
  "description": "Olan Apps backend runtime: isolated-vm and QuickJS engines behind one AppRuntime interface, plus the app-runtime process protocol",
  "homepage": "https://docs.olan.app",
  "bugs": {
    "url": "https://github.com/alkamanas/olan-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkamanas/olan-app.git",
    "directory": "packages/app-runtime"
  },
  "license": "MIT",
  "author": "Alkamanas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "olan-app-runtime": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract-suite": {
      "types": "./dist/contract-suite.d.ts",
      "default": "./dist/contract-suite.js"
    },
    "./main": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check-dist": "tsx scripts/check-dist.ts"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.1"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
