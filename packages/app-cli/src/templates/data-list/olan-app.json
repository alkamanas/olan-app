{
  "$schema": "https://olan.app/schemas/olan-app/v1.json",
  "schemaVersion": 1,
  "id": "{{appId}}",
  "name": "{{appName}}",
  "version": "0.1.0",
  "sdk": "^1.8.0",
  "minServerVersion": "{{minServerVersion}}",
  "description": "Ekibin notları, uygulamanın kendi veritabanında",
  "entry": "dist/app.js",
  "icon": "assets/icon.png",
  "surfaces": {
    "app": { "title": "{{appName}}" }
  },
  "permissions": ["db"],
  "data": {
    "version": 1,
    "collections": {
      "notes": {
        "scope": "organization",
        "fields": {
          "title": { "type": "string", "required": true, "maxLength": 200, "indexed": true, "label": "Başlık" },
          "body": { "type": "string", "maxLength": 2000, "label": "Not" },
          "done": { "type": "boolean", "indexed": true, "label": "Tamamlandı" }
        },
        "rules": { "read": "any", "update": "any", "delete": "owner" }
      }
    }
  }
}
