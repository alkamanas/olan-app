{
  "$schema": "https://olan.app/schemas/olan-app/v1.json",
  "schemaVersion": 1,
  "id": "{{appId}}",
  "name": "{{appName}}",
  "version": "0.1.0",
  "sdk": "^1.8.0",
  "minServerVersion": "{{minServerVersion}}",
  "entry": "dist/app.js",
  "icon": "assets/icon.png",
  "surfaces": {
    "app": { "title": "{{appName}}" }
  },
  "permissions": ["db"],
  "settings": {
    "apiToken": { "type": "string", "label": "API anahtarı", "secret": true }
  },
  "data": {
    "version": 1,
    "collections": {
      "notes": {
        "scope": "organization",
        "fields": {
          "text": { "type": "string", "required": true, "maxLength": 500, "label": "Not" },
          "source": { "type": "string", "enum": ["ui", "schedule"], "indexed": true }
        }
      }
    }
  },
  "server": {
    "entry": "server/index.ts",
    "schedules": [{ "name": "heartbeat", "cron": "0 * * * *" }]
  }
}
