{
  "$schema": "https://olan.app/schemas/olan-app/v1.json",
  "schemaVersion": 1,
  "id": "com.olan.examples.overdue-widget",
  "name": "Geciken görevler",
  "version": "0.1.0",
  "sdk": "^1.0.0",
  "minServerVersion": "0.1.0",
  "description": "Proje sayfasında projenin geciken görevleri",
  "entry": "dist/app.js",
  "icon": "assets/icon.png",
  "surfaces": {
    "project.widget": { "title": "Gecikenler" }
  },
  "permissions": ["projects:read"],
  "settings": {
    "graceDays": {
      "type": "number",
      "label": "Tolerans (gün)",
      "description": "Bitiş tarihinden bu kadar gün sonrasına kadar görev gecikmiş sayılmaz",
      "default": 0
    }
  }
}
